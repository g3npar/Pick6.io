# ── API server ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (AWS RDS or any Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated list of allowed frontend origins for CORS
# e.g. https://nfl-gridlock.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Port the API listens on (defaults to 3001 if not set)
API_PORT=3001

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL of the deployed API (used by the Vite build)
# For local dev this defaults to http://localhost:3001 in the code
VITE_API_URL=http://localhost:3001
